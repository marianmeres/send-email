{
  "name": "@marianmeres/send-email",
  "version": "1.2.0",
  "description": "Low-level, dependency-light \"send an email\" path: a provider-agnostic transport interface, a nodemailer SMTP transport, a mock transport, a one-shot send() and a send-email CLI.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "bin": {
    "send-email": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist",
    "API.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/send-email.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/send-email/issues"
  },
  "homepage": "https://github.com/marianmeres/send-email#readme",
  "keywords": [
    "email",
    "smtp",
    "nodemailer",
    "mail",
    "transport",
    "cli"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "test:deno": "CLI_RUNTIME=deno deno test -A --no-check --no-lock --config jsr.json tests/",
    "smoke": "pnpm run build && node scripts/smoke-npm.ts",
    "jsr:check": "deno publish --dry-run --allow-dirty --no-check --set-version \"$npm_package_version\"",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run smoke",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "release": "npx --yes @marianmeres/release@^2.2.0 --before-commit \"node scripts/sync-version.ts\"",
    "publish:jsr": "pnpm run test:deno && deno publish --no-check --set-version \"$npm_package_version\"",
    "publish:all": "pnpm publish && pnpm run publish:jsr",
    "rp": "pnpm run release -y && pnpm run publish:all",
    "rpm": "pnpm run release minor -y && pnpm run publish:all"
  },
  "dependencies": {
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
